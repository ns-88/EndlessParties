<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup Label="Microsoft">
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
		<PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.13" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
		<PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
		<PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
	</ItemGroup>
	<ItemGroup Label="Persistance">
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
		<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageVersion Include="Npgsql" Version="10.0.3" />
		<PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
		<PackageVersion Include="DatabaseSchemaReader" Version="2.22.0" />
		<PackageVersion Include="StackExchange.Redis" Version="3.4.20" />
	</ItemGroup>
	<ItemGroup Label="Logs">
		<PackageVersion Include="Serilog" Version="4.4.0" />
		<PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
		<PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
		<PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
		<PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
	</ItemGroup>
	<ItemGroup Label="Queue">
		<PackageVersion Include="KafkaFlow" Version="4.2.0" />
		<PackageVersion Include="KafkaFlow.Microsoft.DependencyInjection" Version="4.2.0" />
		<PackageVersion Include="KafkaFlow.Serializer.JsonCore" Version="4.2.0" />
	</ItemGroup>
	<ItemGroup Label="Miscellaneous">
		<PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
		<PackageVersion Include="FluentValidation" Version="12.2.0" />
		<PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
		<PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
		<PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageVersion>
		<PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
	</ItemGroup>
	<ItemGroup Label="Observability">
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.20.1-beta.1" />
		<PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
	</ItemGroup>
	<ItemGroup Label="Tests">
		<PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
		<PackageVersion Include="Moq" Version="4.21.0" />
		<PackageVersion Include="Moq.AutoMock" Version="4.0.3" />
		<PackageVersion Include="AutoFixture" Version="4.18.1" />
		<PackageVersion Include="FluentAssertions" Version="8.11.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
		<PackageVersion Include="Testcontainers.XunitV3" Version="4.16.0" />
		<PackageVersion Include="Respawn" Version="7.0.0" />
	</ItemGroup>
</Project>