{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Migrations": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": {
      "Identity": "Host=localhost:5432;Username=postgres;Password=postgres;Database=endless_parties_identity;"
    }
  },
  "Database": {
    "RetryOnFailureCount": 3
  },
  "JwtToken": {
    "SecretKey": "secretKey",
    "Issuer": "EndlessParties.Identity.Api",
    "Audiences": [ "EndlessParties.Events.Api", "EndlessParties.Bookings.Api" ],
    "Expires": 20
  },
  "Observability": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "EndlessParties.Identity.Api"
  }
}