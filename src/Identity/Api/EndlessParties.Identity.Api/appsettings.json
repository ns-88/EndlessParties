{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Migrations": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "Postgres": {
      "Identity": "Host=localhost:5432;Username=postgres;Password=postgres;Database=endless_parties_identity;"
    }
  },
  "Database": {
    "RetryOnFailureCount": 3
  },
  "JwtToken": {
    "SecretKey": "secretKey",
    "Issuer": "EndlessParties.Identity.Api",
    "Audiences": [ "EndlessParties.Events.Api", "EndlessParties.Bookings.Api" ],
    "Expires": 20
  },
  "Observability": {
    "OltpEndpoint": "localhost:4317",
    "ServiceName": "EndlessParties.Identity.Api"
  }
}