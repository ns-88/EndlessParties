{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Migrations": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": {
      "Events": "Host=localhost:5433;Username=postgres;Password=postgres;Database=endless_parties_events;"
    }
  },
  "Database": {
    "RetryOnFailureCount": 3
  },
  "Kafka": {
    "Environment": "develop",
    "BrokerAddress": "localhost:9094"
  },
  "Redis": {
    "Host": "localhost",
    "Port": "6379",
    "ClientName": "EndlessParties.Events"
  },
  "Identity": {
    "JwtToken": {
      "SecretKey": "secretKey",
      "Issuer": "EndlessParties.Identity.Api",
      "Audience": "EndlessParties.Events.Api"
    }
  },
  "Observability": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "EndlessParties.Events.Api"
  }
}